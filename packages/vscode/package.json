{
  "name": "typegraph-vscode",
  "displayName": "TypeGraph",
  "description": "Typed backlinks and a graph view for your markdown and code, with no Obsidian required.",
  "version": "0.5.1",
  "private": true,
  "publisher": "pavlyshyn",
  "license": "MIT",
  "type": "module",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Volland/obsigraph"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "backlinks",
    "graph",
    "lat.md",
    "knowledge graph",
    "typed links"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:**/*.md",
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "TypeGraph",
      "properties": {
        "typegraph.roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "."
          ],
          "markdownDescription": "Folders, relative to the workspace folder, whose markdown and annotated source files form the graph. Dot folders and `node_modules` are always skipped."
        },
        "typegraph.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules"
          ],
          "markdownDescription": "Folder names skipped at any depth, in addition to dot folders."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "typegraph",
          "title": "TypeGraph",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "typegraph": [
        {
          "id": "typegraph.backlinks",
          "name": "Backlinks"
        }
      ]
    },
    "commands": [
      {
        "command": "typegraph.openGraph",
        "title": "TypeGraph: Open Graph",
        "icon": "$(graph)"
      },
      {
        "command": "typegraph.setup",
        "title": "TypeGraph: Set Up TypeGraph"
      },
      {
        "command": "typegraph.refresh",
        "title": "TypeGraph: Refresh Index",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "typegraph.openGraph",
          "when": "view == typegraph.backlinks",
          "group": "navigation"
        },
        {
          "command": "typegraph.refresh",
          "when": "view == typegraph.backlinks",
          "group": "navigation"
        }
      ]
    }
  },
  "dependencies": {
    "@obsigraph/core": "*",
    "@obsigraph/graph-ui": "*",
    "@obsigraph/node-vault": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.2",
    "ovsx": "^0.10.5"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "package": "node esbuild.config.mjs && vsce package --no-dependencies --allow-missing-repository -o typegraph.vsix"
  }
}
